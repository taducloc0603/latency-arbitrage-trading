<Window x:Class="LatencyArbTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Latency Arb Live" Height="760" Width="1180"
        MinHeight="640" MinWidth="980">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="180" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Load Config" Command="{Binding LoadConfigCommand}" />
                <Button Content="Check Maps" Command="{Binding CheckMapsCommand}" />
                <Button Content="Start" Command="{Binding StartCommand}" />
                <Button Content="Stop" Command="{Binding StopCommand}" />
                <TextBlock Text="{Binding ConfigStatus}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding ConfigSummary}" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Map A" Margin="0,0,8,0" />
                <TextBox Text="{Binding MapNameA, UpdateSourceTrigger=PropertyChanged}" Width="160" MinWidth="160" />
                <TextBlock Text="Map B" Margin="0,0,8,0" />
                <TextBox Text="{Binding MapNameB, UpdateSourceTrigger=PropertyChanged}" Width="160" MinWidth="160" />
                <TextBlock Text="Chart HWND B" Margin="0,0,8,0" />
                <TextBox Text="{Binding ChartHwndText, UpdateSourceTrigger=PropertyChanged}" Width="120" MinWidth="120" />
                <TextBlock Text="Trade HWND B" Margin="0,0,8,0" />
                <TextBox Text="{Binding TradeHwndText, UpdateSourceTrigger=PropertyChanged}" Width="120" MinWidth="120" />
                <Button Content="Check HWND" Command="{Binding CheckHwndCommand}" />
                <Button Content="Save Config" Command="{Binding SaveConfigCommand}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="HWND: " />
                <TextBlock Text="{Binding HwndStatus}" FontWeight="SemiBold" Margin="0,0,16,0" />
                <TextBlock Text="{Binding LiveStatus}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- star so the Event Log (spanning rows 0-1) has a bounded height and scrolls -->
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Feed A (fast)" Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                <UniformGrid Columns="2" Margin="12">
                    <TextBlock Text="Status" />
                    <TextBlock Text="{Binding StatusA}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Symbol" />
                    <TextBlock Text="{Binding SymbolA}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Bid" />
                    <TextBlock Text="{Binding BidA}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Ask" />
                    <TextBlock Text="{Binding AskA}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Spread" />
                    <TextBlock Text="{Binding SpreadA}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Latency" />
                    <TextBlock Text="{Binding LatencyA}" Style="{StaticResource ValueText}" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="Feed B (slow)" Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                <UniformGrid Columns="2" Margin="12">
                    <TextBlock Text="Status" />
                    <TextBlock Text="{Binding StatusB}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Symbol" />
                    <TextBlock Text="{Binding SymbolB}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Bid" />
                    <TextBlock Text="{Binding BidB}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Ask" />
                    <TextBlock Text="{Binding AskB}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Spread" />
                    <TextBlock Text="{Binding SpreadB}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Latency" />
                    <TextBlock Text="{Binding LatencyB}" Style="{StaticResource ValueText}" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="Strategy" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,12" VerticalAlignment="Top">
                <UniformGrid Columns="4" Margin="12">
                    <TextBlock Text="GapBuy" />
                    <TextBlock Text="{Binding GapBuy}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="GapSell" />
                    <TextBlock Text="{Binding GapSell}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Position" />
                    <TextBlock Text="{Binding PositionSide}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Entry (pt)" />
                    <TextBlock Text="{Binding EntryPoint}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Current (pt)" />
                    <TextBlock Text="{Binding CurrentPoint}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="Trailing" />
                    <TextBlock Text="{Binding TrailingState}" Style="{StaticResource ValueText}" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="Event Log" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="0,0,0,12">
                <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </GroupBox>

            <TabControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <TabItem Header="B Trade">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusBTrade}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding BTrades}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" FontFamily="Consolas" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="Auto" />
                                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="Auto" />
                                <DataGridTextColumn Header="Lot" Binding="{Binding Lot, StringFormat=0.##}" Width="Auto" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=0.#####}" Width="Auto" />
                                <DataGridTextColumn Header="SL" Binding="{Binding StopLoss, StringFormat=0.#####}" Width="Auto" />
                                <DataGridTextColumn Header="TP" Binding="{Binding TakeProfit, StringFormat=0.#####}" Width="Auto" />
                                <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat=0.##}" Width="Auto" />
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="Auto" />
                                <DataGridTextColumn Header="OpenEaLocal" Binding="{Binding OpenEaTimeLocal}" Width="Auto" />
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="B History">
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusBHistory}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding BHistory}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" FontFamily="Consolas" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="Auto" />
                                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="Auto" />
                                <DataGridTextColumn Header="Volume" Binding="{Binding Volume, StringFormat=0.##}" Width="Auto" />
                                <DataGridTextColumn Header="OpenPrice" Binding="{Binding OpenPrice, StringFormat=0.#####}" Width="Auto" />
                                <DataGridTextColumn Header="ClosePrice" Binding="{Binding ClosePrice, StringFormat=0.#####}" Width="Auto" />
                                <DataGridTextColumn Header="SL" Binding="{Binding StopLoss, StringFormat=0.#####}" Width="Auto" />
                                <DataGridTextColumn Header="TP" Binding="{Binding TakeProfit, StringFormat=0.#####}" Width="Auto" />
                                <DataGridTextColumn Header="Commission" Binding="{Binding Commission, StringFormat=0.##}" Width="Auto" />
                                <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat=0.##}" Width="Auto" />
                                <DataGridTextColumn Header="OpenTime" Binding="{Binding OpenTime}" Width="Auto" />
                                <DataGridTextColumn Header="CloseTime" Binding="{Binding CloseTime}" Width="Auto" />
                                <DataGridTextColumn Header="CloseEaLocal" Binding="{Binding CloseEaTimeLocal}" Width="Auto" />
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
