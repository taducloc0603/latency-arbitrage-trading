<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LatencyArbTool.Core\LatencyArbTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\native\mt5engine-capi\mt5engine-capi.dll')">
    <None Include="..\native\mt5engine-capi\mt5engine-capi.dll">
      <Link>mt5engine-capi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
